# Environments
.venv/
# Rust build output
/target/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
.benchmarks/

# Data: regenerated from pins, verified by datasets/MANIFEST.sha256
datasets/raw/
datasets/processed/**
!datasets/processed/meta.json
datasets/processed/**/*_shards/

#datasets in self test too 
_selftest/

# Runtime state (databases, key files, certificates) holds ciphertext, keys and the user's
# secret r_t values — never commit. Golden vectors (spec Appendix B) are committed.
*.cert
# Per-session demo receipts (public by design, but tied to one session's keys)
demo/results/certs/
# The engine demo's databases, account keys and receipts
demo-engine/work/
*.key
!golden/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Partition artefacts: rebuilt by sever_partition.build, identified by hash in the ledger
/artefacts/
# Trace files from real data: regenerated by sever_testkit.traces; hashes in tests/traces/MANIFEST.sha256
/traces/
# cargo-fuzz working corpora, crashes and build output (the committed seeds are fuzz/seeds/)
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/target/
/spikes/*/target/
/.coverage
/fuzz-p2/corpus/
/fuzz-p2/artifacts/
/fuzz-p2/target/
/jobs/
/verifier/target/
/audit/target/
/fuzz-p3/corpus/
/fuzz-p3/artifacts/
/fuzz-p3/target/
/verifier/fuzz/corpus/
/verifier/fuzz/artifacts/
/verifier/fuzz/target/
